{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "cell_id",
    "owner",
    "generation",
    "sha",
    "resources"
  ],
  "properties": {
    "schema_version": {
      "const": "cell-resources/v1"
    },
    "cell_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "owner": {
      "type": "string"
    },
    "generation": {
      "type": "integer",
      "minimum": 0
    },
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "cell_id",
          "owner",
          "kind",
          "name",
          "generation",
          "sha",
          "revision",
          "state",
          "leases",
          "guard",
          "certificate",
          "receipt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "cell_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "owner": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "qa-clone",
              "server",
              "port",
              "process",
              "device",
              "tunnel"
            ]
          },
          "name": {
            "type": "string"
          },
          "generation": {
            "type": "integer",
            "minimum": 0
          },
          "sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "state": {
            "enum": [
              "USING",
              "GUARDED",
              "CERTIFIED",
              "CLEANING",
              "CLEANED"
            ]
          },
          "leases": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "consumer"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                },
                "consumer": {
                  "type": "string"
                }
              }
            }
          },
          "guard": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "final",
                  "passed",
                  "sha",
                  "generation"
                ],
                "properties": {
                  "final": {
                    "type": "boolean"
                  },
                  "passed": {
                    "type": "boolean"
                  },
                  "exact_sha": {
                    "type": "boolean"
                  },
                  "clone_boundary": {
                    "type": "boolean"
                  },
                  "source_unchanged": {
                    "type": "boolean"
                  },
                  "refs_unchanged": {
                    "type": "boolean"
                  },
                  "sha": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{40}$"
                  },
                  "generation": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            ]
          },
          "certificate": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "resource_id",
                  "cell_id",
                  "owner",
                  "generation",
                  "sha",
                  "revision",
                  "state",
                  "guard_digest"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  },
                  "resource_id": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  },
                  "cell_id": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  },
                  "owner": {
                    "type": "string"
                  },
                  "generation": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "sha": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{40}$"
                  },
                  "revision": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "state": {
                    "const": "GUARDED"
                  },
                  "guard_digest": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                }
              }
            ]
          },
          "receipt": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "certificate_id",
                  "resource_id",
                  "sha",
                  "generation",
                  "outcome"
                ],
                "properties": {
                  "certificate_id": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  },
                  "resource_id": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  },
                  "sha": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{40}$"
                  },
                  "generation": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "outcome": {
                    "const": "cleaned"
                  }
                }
              }
            ]
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/barucoh/pleiad/resource-ledger.schema.json",
  "title": "Portable cell operational ownership and cleanup evidence"
}
