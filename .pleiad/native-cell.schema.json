{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mode",
    "cell_id",
    "repository",
    "issue_number",
    "issue_url",
    "branch",
    "pr_url",
    "sha",
    "generation",
    "state",
    "ci",
    "assignments",
    "results",
    "events",
    "deliveries",
    "denials",
    "pending_findings"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "native-cell/v1"
    },
    "mode": {
      "type": "string",
      "const": "native"
    },
    "cell_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "repository": {
      "type": "string",
      "minLength": 3
    },
    "issue_number": {
      "type": "integer",
      "minimum": 1
    },
    "issue_url": {
      "type": "string",
      "pattern": "^https://github.com/[^\\s]+$"
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "pr_url": {
      "type": "string"
    },
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "generation": {
      "type": "integer",
      "minimum": 0
    },
    "state": {
      "type": "string",
      "enum": [
        "IMPLEMENTATION_ACTIVE",
        "IMPLEMENTATION_READY",
        "CHANGES_REQUESTED",
        "CORRECTION_ACTIVE",
        "LOCAL_REVIEW_READY"
      ]
    },
    "ci": {
      "type": "string",
      "enum": [
        "pending",
        "passed",
        "failed"
      ]
    },
    "assignments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "role",
          "sha",
          "generation",
          "objective",
          "model",
          "effort",
          "rationale",
          "authorization"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "role": {
            "type": "string",
            "enum": [
              "coordinator",
              "implementation",
              "qa",
              "reviewer",
              "product",
              "architecture",
              "knowledge_steward"
            ]
          },
          "sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "generation": {
            "type": "integer",
            "minimum": 0
          },
          "objective": {
            "type": "string",
            "minLength": 1
          },
          "model": {
            "type": "string",
            "enum": [
              "gpt-6-luna",
              "gpt-6.1-sol",
              "gpt-6-astra"
            ]
          },
          "effort": {
            "type": "string",
            "enum": [
              "Low",
              "Medium",
              "High"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "authorization": {
            "type": "string"
          }
        }
      }
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "assignment_id",
          "role",
          "sha",
          "generation",
          "status",
          "evidence",
          "findings",
          "fixes",
          "checks",
          "final_guard"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "assignment_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "role": {
            "type": "string",
            "enum": [
              "coordinator",
              "implementation",
              "qa",
              "reviewer",
              "product",
              "architecture",
              "knowledge_steward"
            ]
          },
          "sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "generation": {
            "type": "integer",
            "minimum": 0
          },
          "status": {
            "type": "string",
            "enum": [
              "ready",
              "passed",
              "changes_requested",
              "blocked",
              "completed"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^https://github.com/[^\\s]+$"
            }
          },
          "findings": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "description"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "fixes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "finding_id",
                "evidence"
              ],
              "properties": {
                "finding_id": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence": {
                  "type": "string",
                  "pattern": "^https://github.com/[^\\s]+$"
                }
              }
            }
          },
          "checks": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "status"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "passed",
                    "failed",
                    "pending"
                  ]
                }
              }
            }
          },
          "final_guard": {
            "type": "boolean"
          }
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "sha",
          "generation",
          "reference"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "generation": {
            "type": "integer",
            "minimum": 0
          },
          "reference": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "deliveries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "event_id",
          "assignment_id",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "event_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "assignment_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "status": {
            "type": "string",
            "enum": [
              "unknown",
              "absent",
              "applied"
            ]
          }
        }
      }
    },
    "denials": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "reason",
          "status",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "unresolved",
              "resolved"
            ]
          },
          "evidence": {
            "type": "string"
          }
        }
      }
    },
    "pending_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/barucoh/pleiad/native-cell.schema.json",
  "title": "Portable native Coordinator checkpoint"
}
